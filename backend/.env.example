# ==================== REQUIRED CONFIGURATION ====================

# Database Connection
# CRITICAL: Update this with your PostgreSQL connection details
DATABASE_URL="postgresql://user:password@localhost:5432/minecraft_hosting"

# JWT Secret Key
# CRITICAL: Generate a secure random string (min 32 characters)
# Generate with: openssl rand -base64 32
# NEVER use the default value in production!
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS

# ==================== SERVER CONFIGURATION ====================

# Application Environment
NODE_ENV=development

# API Server Port
PORT=3000

# WebSocket Server Port
WS_PORT=3001

# ==================== SECURITY CONFIGURATION ====================

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
# Example: http://localhost:5173,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting (DDoS Protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== FILE & BACKUP CONFIGURATION ====================

# Maximum upload file size (bytes) - Default: 100MB
MAX_FILE_SIZE=104857600

# Upload directory for mods
UPLOAD_DIR=./uploads

# Backup directory
BACKUP_DIR=./backups

# Automatic backup interval
AUTO_BACKUP_INTERVAL=24h

# ==================== MINECRAFT CONFIGURATION ====================

# Minecraft Version Manifest URL
MINECRAFT_MANIFEST_URL=https://launchermeta.mojang.com/mc/game/version_manifest.json
