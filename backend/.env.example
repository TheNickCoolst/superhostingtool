# Database
DATABASE_URL="postgresql://user:password@localhost:5432/minecraft_hosting"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# WebSocket
WS_PORT=3001

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads

# Backup
BACKUP_DIR=./backups
AUTO_BACKUP_INTERVAL=24h

# DDoS Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Minecraft
MINECRAFT_MANIFEST_URL=https://launchermeta.mojang.com/mc/game/version_manifest.json
