// Prisma Schema für Minecraft Hosting Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== User Models ====================
model User {
  id            String          @id @default(uuid())
  email         String          @unique
  username      String          @unique
  password      String
  role          UserRole        @default(USER)
  maxServers    Int             @default(9)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  servers       MinecraftServer[]

  @@index([email])
  @@index([username])
}

enum UserRole {
  ADMIN
  USER
  MODERATOR
}

// ==================== Host Models ====================
model Host {
  id              String          @id @default(uuid())
  name            String
  ipAddress       String          @unique
  apiKey          String
  status          HostStatus      @default(OFFLINE)
  totalRam        Int             // in MB
  totalCpu        Float           // number of cores
  usedRam         Int             @default(0)
  usedCpu         Float           @default(0)
  maxServers      Int             @default(50)
  activeServers   Int             @default(0)
  region          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastHeartbeat   DateTime?

  servers         MinecraftServer[]

  @@index([status])
  @@index([region])
  @@index([lastHeartbeat])
}

enum HostStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  OVERLOADED
}

// ==================== Minecraft Server Models ====================
model MinecraftServer {
  id                String              @id @default(uuid())
  name              String
  userId            String
  hostId            String
  status            ServerStatus        @default(CREATING)
  version           String
  minecraftVersion  MinecraftVersionType
  port              Int
  allocatedRam      Int                 // in MB
  allocatedCpu      Float               // in cores
  maxPlayers        Int                 @default(20)
  difficulty        Difficulty          @default(NORMAL)
  gameMode          GameMode            @default(SURVIVAL)
  enableWhitelist   Boolean             @default(false)
  containerName     String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lastStarted       DateTime?

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  host              Host                @relation(fields: [hostId], references: [id])
  mods              ServerMod[]
  backups           Backup[]
  stats             ServerStats?
  whitelist         PlayerWhitelist[]
  bans              PlayerBan[]
  operators         PlayerOperator[]
  scheduledTasks    ScheduledTask[]
  metrics           ServerMetrics[]
  consoleLogs       ConsoleLog[]

  @@index([userId])
  @@index([hostId])
  @@index([status])
}

enum ServerStatus {
  CREATING
  STOPPED
  STARTING
  RUNNING
  STOPPING
  RESTARTING
  ERROR
  UPDATING
}

enum MinecraftVersionType {
  VANILLA
  SNAPSHOT
  FORGE
  FABRIC
  PAPER
  SPIGOT
  BUKKIT
}

enum Difficulty {
  PEACEFUL
  EASY
  NORMAL
  HARD
}

enum GameMode {
  SURVIVAL
  CREATIVE
  ADVENTURE
  SPECTATOR
}

// ==================== Mod Models ====================
model Mod {
  id                String          @id @default(uuid())
  name              String
  description       String
  version           String
  minecraftVersion  String
  modLoader         ModLoader
  fileUrl           String?
  fileName          String
  fileSize          Int
  author            String
  dependencies      String[]        @default([])
  createdAt         DateTime        @default(now())

  servers           ServerMod[]

  @@index([modLoader])
  @@index([minecraftVersion])
}

enum ModLoader {
  FORGE
  FABRIC
  QUILT
}

model ServerMod {
  id          String          @id @default(uuid())
  modId       String
  serverId    String
  enabled     Boolean         @default(true)
  installedAt DateTime        @default(now())

  mod         Mod             @relation(fields: [modId], references: [id], onDelete: Cascade)
  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([modId, serverId])
  @@index([serverId])
}

// ==================== Backup Models ====================
model Backup {
  id          String          @id @default(uuid())
  serverId    String
  name        String
  size        Int             // in bytes
  type        BackupType
  status      BackupStatus    @default(CREATING)
  filePath    String
  createdAt   DateTime        @default(now())
  restoredAt  DateTime?

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([status])
  @@index([createdAt])
  @@index([type, createdAt])
}

enum BackupType {
  MANUAL
  AUTOMATIC
  PRE_UPDATE
}

enum BackupStatus {
  CREATING
  COMPLETED
  FAILED
  RESTORING
}

// ==================== Stats Models ====================
model ServerStats {
  id            String          @id @default(uuid())
  serverId      String          @unique
  onlinePlayers Int             @default(0)
  maxPlayers    Int             @default(20)
  tps           Float           @default(20.0)
  ramUsage      Int             @default(0)
  cpuUsage      Float           @default(0)
  uptime        Int             @default(0)
  lastUpdated   DateTime        @default(now())

  server        MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ==================== Minecraft Version Models ====================
model MinecraftVersion {
  id            String                @id @default(uuid())
  version       String                @unique
  type          MinecraftVersionType
  releaseDate   DateTime
  downloadUrl   String?
  isStable      Boolean               @default(true)

  @@index([type])
  @@index([version])
}

// ==================== Server Template Models ====================
model ServerTemplate {
  id                String              @id @default(uuid())
  name              String
  description       String
  minecraftVersion  String
  versionType       MinecraftVersionType
  allocatedRam      Int                 // in MB
  allocatedCpu      Float
  maxPlayers        Int                 @default(20)
  difficulty        Difficulty          @default(NORMAL)
  gameMode          GameMode            @default(SURVIVAL)
  enableWhitelist   Boolean             @default(false)
  preInstalledMods  String[]            @default([])
  serverProperties  Json?               // Custom server.properties
  isPublic          Boolean             @default(true)
  createdBy         String?
  downloads         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([isPublic])
  @@index([versionType])
}

// ==================== Player Management Models ====================
model PlayerWhitelist {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  addedAt     DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

model PlayerBan {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  reason      String?
  bannedBy    String?
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

model PlayerOperator {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  level       Int             @default(4)
  addedAt     DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

// ==================== Scheduled Task Models ====================
model ScheduledTask {
  id            String          @id @default(uuid())
  serverId      String
  name          String
  taskType      TaskType
  cronExpression String
  command       String?
  enabled       Boolean         @default(true)
  lastRun       DateTime?
  nextRun       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  server        MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([enabled])
  @@index([nextRun])
}

enum TaskType {
  BACKUP
  RESTART
  COMMAND
  ANNOUNCEMENT
}

// ==================== Notification Models ====================
model NotificationConfig {
  id          String              @id @default(uuid())
  userId      String
  serverId    String?
  type        NotificationType
  enabled     Boolean             @default(true)
  email       String?
  webhookUrl  String?
  events      NotificationEvent[] @default([])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([serverId])
}

enum NotificationType {
  EMAIL
  WEBHOOK
  DISCORD
}

enum NotificationEvent {
  SERVER_STARTED
  SERVER_STOPPED
  SERVER_CRASHED
  BACKUP_COMPLETED
  BACKUP_FAILED
  PLAYER_JOINED
  PLAYER_LEFT
  HIGH_CPU_USAGE
  HIGH_RAM_USAGE
  LOW_TPS
}

// ==================== Advanced Analytics Models ====================
model ServerMetrics {
  id              String          @id @default(uuid())
  serverId        String
  timestamp       DateTime        @default(now())
  cpuUsage        Float
  ramUsage        Int
  diskUsage       Int?
  tps             Float
  onlinePlayers   Int
  chunks          Int?
  entities        Int?
  tileEntities    Int?

  server          MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp])
  @@index([timestamp])
}

model ConsoleLog {
  id          String          @id @default(uuid())
  serverId    String
  message     String
  level       LogLevel        @default(INFO)
  timestamp   DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp])
  @@index([timestamp])
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  SEVERE
  DEBUG
}

// ==================== AI/ML Performance Models ====================
model AIPerformancePrediction {
  id                  String          @id @default(uuid())
  serverId            String
  predictedCpu        Float
  predictedRam        Int
  predictedPlayers    Int
  predictedTps        Float
  confidence          Float           // 0.0 - 1.0
  timeframe           Int             // minutes ahead
  predictionTime      DateTime        @default(now())
  actualCpu           Float?
  actualRam           Int?
  actualPlayers       Int?
  accuracy            Float?

  @@index([serverId, predictionTime])
  @@index([predictionTime])
}

model AnomalyDetection {
  id              String          @id @default(uuid())
  serverId        String
  anomalyType     AnomalyType
  severity        AnomalySeverity
  description     String
  metricValue     Float
  expectedValue   Float
  deviation       Float
  detectedAt      DateTime        @default(now())
  resolved        Boolean         @default(false)
  resolvedAt      DateTime?
  autoResolved    Boolean         @default(false)

  @@index([serverId, detectedAt])
  @@index([resolved])
  @@index([severity])
}

enum AnomalyType {
  CPU_SPIKE
  MEMORY_LEAK
  TPS_DROP
  PLAYER_SURGE
  DISK_FULL
  NETWORK_LATENCY
  CRASH_PATTERN
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ResourceOptimization {
  id                    String          @id @default(uuid())
  serverId              String
  currentRam            Int
  currentCpu            Float
  recommendedRam        Int
  recommendedCpu        Float
  potentialSavings      Float           // in percentage
  reasoning             String
  confidence            Float
  applied               Boolean         @default(false)
  appliedAt             DateTime?
  createdAt             DateTime        @default(now())

  @@index([serverId, createdAt])
  @@index([applied])
}

// ==================== Plugin Marketplace Models ====================
model MarketplacePlugin {
  id                String              @id @default(uuid())
  name              String
  slug              String              @unique
  description       String
  longDescription   String?
  category          PluginCategory
  author            String
  authorUrl         String?
  iconUrl           String?
  sourceUrl         String?
  minecraftVersions String[]
  modLoaders        ModLoader[]
  curseforgeId      String?             @unique
  modrinthId        String?             @unique
  downloads         Int                 @default(0)
  rating            Float               @default(0)
  ratingCount       Int                 @default(0)
  featured          Boolean             @default(false)
  verified          Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  versions          PluginVersion[]
  installations     PluginInstallation[]

  @@index([category])
  @@index([featured])
  @@index([downloads])
  @@index([rating])
}

enum PluginCategory {
  OPTIMIZATION
  GAMEPLAY
  MECHANICS
  WORLD_GEN
  MOBS
  ITEMS
  ECONOMY
  ADMIN_TOOLS
  UTILITY
  DECORATION
  TECHNOLOGY
  MAGIC
  ADVENTURE
}

model PluginVersion {
  id                String              @id @default(uuid())
  pluginId          String
  version           String
  minecraftVersion  String
  modLoader         ModLoader
  downloadUrl       String
  fileSize          Int
  changelog         String?
  isStable          Boolean             @default(true)
  downloads         Int                 @default(0)
  createdAt         DateTime            @default(now())

  plugin            MarketplacePlugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, version, minecraftVersion, modLoader])
  @@index([pluginId])
}

model PluginInstallation {
  id              String              @id @default(uuid())
  serverId        String
  pluginId        String
  versionId       String
  status          InstallStatus       @default(PENDING)
  installedAt     DateTime            @default(now())

  plugin          MarketplacePlugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([serverId, pluginId])
  @@index([serverId])
  @@index([status])
}

enum InstallStatus {
  PENDING
  DOWNLOADING
  INSTALLING
  INSTALLED
  FAILED
  UNINSTALLING
}

// ==================== Multi-Server Network Models ====================
model ServerNetwork {
  id              String              @id @default(uuid())
  name            String
  description     String?
  networkType     NetworkType
  proxyServerId   String?             @unique
  proxyPort       Int?
  proxyHost       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  members         NetworkMember[]

  @@index([networkType])
}

enum NetworkType {
  BUNGEECORD
  VELOCITY
  WATERFALL
}

model NetworkMember {
  id              String          @id @default(uuid())
  networkId       String
  serverId        String
  serverName      String
  priority        Int             @default(0)
  restricted      Boolean         @default(false)
  motd            String?
  addedAt         DateTime        @default(now())

  network         ServerNetwork   @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([networkId, serverId])
  @@index([networkId])
}

// ==================== Advanced Security Models ====================
model AuditLog {
  id              String          @id @default(uuid())
  userId          String
  userName        String
  action          AuditAction
  resource        String          // e.g., "server", "user", "backup"
  resourceId      String
  details         Json?
  ipAddress       String?
  userAgent       String?
  success         Boolean         @default(true)
  errorMessage    String?
  timestamp       DateTime        @default(now())

  @@index([userId, timestamp])
  @@index([resource, resourceId])
  @@index([timestamp])
  @@index([action])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  START
  STOP
  RESTART
  BACKUP
  RESTORE
  LOGIN
  LOGOUT
  CONFIG_CHANGE
  PERMISSION_CHANGE
  FILE_UPLOAD
  FILE_DELETE
  COMMAND_EXECUTE
}

model TwoFactorAuth {
  id              String          @id @default(uuid())
  userId          String          @unique
  secret          String
  enabled         Boolean         @default(false)
  backupCodes     String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
}

model SecurityScan {
  id              String          @id @default(uuid())
  serverId        String
  scanType        ScanType
  status          ScanStatus      @default(PENDING)
  vulnerabilities Json[]
  severity        String?
  startedAt       DateTime        @default(now())
  completedAt     DateTime?

  @@index([serverId, startedAt])
  @@index([status])
}

enum ScanType {
  CONTAINER
  DEPENDENCIES
  CONFIGURATION
  FILES
}

enum ScanStatus {
  PENDING
  SCANNING
  COMPLETED
  FAILED
}

// ==================== Webhook System Models ====================
model Webhook {
  id              String              @id @default(uuid())
  userId          String
  name            String
  url             String
  secret          String?
  events          WebhookEvent[]
  enabled         Boolean             @default(true)
  retryCount      Int                 @default(3)
  timeout         Int                 @default(30000)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  deliveries      WebhookDelivery[]

  @@index([userId])
  @@index([enabled])
}

enum WebhookEvent {
  SERVER_CREATED
  SERVER_DELETED
  SERVER_STARTED
  SERVER_STOPPED
  SERVER_CRASHED
  BACKUP_COMPLETED
  BACKUP_FAILED
  PLAYER_JOINED
  PLAYER_LEFT
  ANOMALY_DETECTED
  RESOURCE_OPTIMIZED
  SECURITY_ALERT
}

model WebhookDelivery {
  id              String          @id @default(uuid())
  webhookId       String
  event           WebhookEvent
  payload         Json
  status          DeliveryStatus  @default(PENDING)
  responseCode    Int?
  responseBody    String?
  attempts        Int             @default(0)
  lastAttempt     DateTime?
  createdAt       DateTime        @default(now())

  webhook         Webhook         @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([status])
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

// ==================== Disaster Recovery Models ====================
model DisasterRecoveryPlan {
  id                    String          @id @default(uuid())
  serverId              String          @unique
  enabled               Boolean         @default(false)
  failoverHostId        String?
  backupFrequency       Int             @default(60)    // minutes
  geoReplication        Boolean         @default(false)
  replicationRegions    String[]
  autoFailover          Boolean         @default(false)
  healthCheckInterval   Int             @default(5)     // minutes
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([enabled])
}

model FailoverEvent {
  id                String          @id @default(uuid())
  serverId          String
  reason            String
  sourceHostId      String
  targetHostId      String
  status            FailoverStatus  @default(INITIATED)
  startedAt         DateTime        @default(now())
  completedAt       DateTime?
  downtime          Int?            // seconds
  success           Boolean?
  errorMessage      String?

  @@index([serverId, startedAt])
  @@index([status])
}

enum FailoverStatus {
  INITIATED
  BACKING_UP
  TRANSFERRING
  STARTING
  COMPLETED
  FAILED
  ROLLED_BACK
}

// ==================== World Management Models ====================
model WorldTemplate {
  id                String          @id @default(uuid())
  name              String
  description       String
  minecraftVersion  String
  worldType         WorldType
  seed              String?
  size              Int             // in MB
  previewImage      String?
  downloadUrl       String
  downloads         Int             @default(0)
  rating            Float           @default(0)
  featured          Boolean         @default(false)
  tags              String[]
  createdAt         DateTime        @default(now())

  @@index([worldType])
  @@index([featured])
  @@index([downloads])
}

enum WorldType {
  SURVIVAL
  CREATIVE
  ADVENTURE
  SKYBLOCK
  PRISON
  MINIGAME
  CUSTOM
}

model ChunkPregeneration {
  id              String          @id @default(uuid())
  serverId        String
  status          PregenStatus    @default(PENDING)
  radius          Int
  centerX         Int
  centerZ         Int
  progress        Float           @default(0)
  chunksTotal     Int?
  chunksCompleted Int             @default(0)
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  estimatedTime   Int?            // seconds

  @@index([serverId, status])
}

enum PregenStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

// ==================== Advanced Backup Models ====================
model BackupSchedule {
  id              String          @id @default(uuid())
  serverId        String
  enabled         Boolean         @default(true)
  cronExpression  String
  retentionDays   Int             @default(7)
  incremental     Boolean         @default(false)
  encrypted       Boolean         @default(false)
  compression     CompressionType @default(GZIP)
  geoReplicate    Boolean         @default(false)
  replicationRegions String[]
  lastRun         DateTime?
  nextRun         DateTime?
  createdAt       DateTime        @default(now())

  @@index([serverId])
  @@index([enabled])
}

enum CompressionType {
  NONE
  GZIP
  ZSTD
  LZ4
}

// ==================== Resource Pool Models ====================
model ResourcePool {
  id              String          @id @default(uuid())
  name            String
  description     String?
  totalRam        Int
  totalCpu        Float
  allocatedRam    Int             @default(0)
  allocatedCpu    Float           @default(0)
  priority        Int             @default(0)
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now())

  members         PoolMember[]

  @@index([enabled])
  @@index([priority])
}

model PoolMember {
  id              String          @id @default(uuid())
  poolId          String
  serverId        String
  priority        Int             @default(0)
  maxRam          Int?
  maxCpu          Float?
  addedAt         DateTime        @default(now())

  pool            ResourcePool    @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([poolId, serverId])
  @@index([poolId])
}

// ==================== Serverless Functions Models ====================
model ServerlessFunction {
  id              String              @id @default(uuid())
  userId          String
  name            String
  description     String?
  trigger         FunctionTrigger
  code            String
  language        FunctionLanguage    @default(JAVASCRIPT)
  enabled         Boolean             @default(true)
  timeout         Int                 @default(30000)
  environment     Json?
  lastRun         DateTime?
  executionCount  Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  executions      FunctionExecution[]

  @@index([userId])
  @@index([enabled])
  @@index([trigger])
}

enum FunctionTrigger {
  HTTP
  SCHEDULE
  SERVER_EVENT
  WEBHOOK
  MANUAL
}

enum FunctionLanguage {
  JAVASCRIPT
  PYTHON
  LUA
}

model FunctionExecution {
  id              String              @id @default(uuid())
  functionId      String
  status          ExecutionStatus     @default(RUNNING)
  input           Json?
  output          Json?
  error           String?
  duration        Int?                // milliseconds
  startedAt       DateTime            @default(now())
  completedAt     DateTime?

  function        ServerlessFunction  @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@index([functionId, startedAt])
  @@index([status])
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
}

// ==================== Multi-Tenancy Models ====================
model Organization {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  logoUrl         String?
  customDomain    String?
  theme           Json?
  plan            PlanType        @default(FREE)
  maxUsers        Int             @default(5)
  maxServers      Int             @default(10)
  features        String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members         OrganizationMember[]

  @@index([slug])
  @@index([plan])
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model OrganizationMember {
  id              String          @id @default(uuid())
  organizationId  String
  userId          String
  role            OrgRole         @default(MEMBER)
  permissions     String[]
  joinedAt        DateTime        @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ==================== Advanced Networking Models ====================
model LoadBalancer {
  id              String          @id @default(uuid())
  name            String
  algorithm       LBAlgorithm     @default(ROUND_ROBIN)
  enabled         Boolean         @default(true)
  healthCheck     Boolean         @default(true)
  stickySession   Boolean         @default(false)
  createdAt       DateTime        @default(now())

  targets         LBTarget[]

  @@index([enabled])
}

enum LBAlgorithm {
  ROUND_ROBIN
  LEAST_CONNECTIONS
  IP_HASH
  WEIGHTED
}

model LBTarget {
  id              String          @id @default(uuid())
  loadBalancerId  String
  serverId        String
  weight          Int             @default(1)
  enabled         Boolean         @default(true)

  loadBalancer    LoadBalancer    @relation(fields: [loadBalancerId], references: [id], onDelete: Cascade)

  @@unique([loadBalancerId, serverId])
  @@index([loadBalancerId])
}

model CustomDNS {
  id              String          @id @default(uuid())
  serverId        String
  domain          String          @unique
  recordType      DNSRecordType   @default(A)
  value           String
  ttl             Int             @default(300)
  proxied         Boolean         @default(false)
  verified        Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@index([serverId])
  @@index([verified])
}

enum DNSRecordType {
  A
  AAAA
  CNAME
  SRV
  TXT
}
