// Prisma Schema für Minecraft Hosting Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== User Models ====================
model User {
  id            String          @id @default(uuid())
  email         String          @unique
  username      String          @unique
  password      String
  role          UserRole        @default(USER)
  maxServers    Int             @default(9)
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret  String?
  apiKeys       ApiKey[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  servers       MinecraftServer[]
  organizations OrganizationMember[]
  favorites     ServerFavorite[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([username])
}

enum UserRole {
  ADMIN
  USER
  MODERATOR
}

// ==================== 2FA Models ====================
model TwoFactorBackupCode {
  id          String    @id @default(uuid())
  userId      String
  code        String
  used        Boolean   @default(false)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([code])
}

// ==================== API Key Models ====================
model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  key         String    @unique
  scopes      String[]  @default(["read"])
  lastUsed    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

// ==================== Host Models ====================
model Host {
  id              String          @id @default(uuid())
  name            String
  ipAddress       String          @unique
  apiKey          String
  status          HostStatus      @default(OFFLINE)
  totalRam        Int             // in MB
  totalCpu        Float           // number of cores
  usedRam         Int             @default(0)
  usedCpu         Float           @default(0)
  maxServers      Int             @default(50)
  activeServers   Int             @default(0)
  region          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastHeartbeat   DateTime?

  servers         MinecraftServer[]

  @@index([status])
  @@index([region])
  @@index([lastHeartbeat])
}

enum HostStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  OVERLOADED
}

// ==================== Minecraft Server Models ====================
model MinecraftServer {
  id                String              @id @default(uuid())
  name              String
  userId            String
  hostId            String
  status            ServerStatus        @default(CREATING)
  version           String
  minecraftVersion  MinecraftVersionType
  port              Int
  allocatedRam      Int                 // in MB
  allocatedCpu      Float               // in cores
  maxPlayers        Int                 @default(20)
  difficulty        Difficulty          @default(NORMAL)
  gameMode          GameMode            @default(SURVIVAL)
  enableWhitelist   Boolean             @default(false)
  containerName     String              @unique
  color             String?             // Hex color for UI
  icon              String?             // Icon name or emoji
  hibernating       Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lastStarted       DateTime?

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  host              Host                @relation(fields: [hostId], references: [id])
  mods              ServerMod[]
  backups           Backup[]
  stats             ServerStats?
  whitelist         PlayerWhitelist[]
  bans              PlayerBan[]
  operators         PlayerOperator[]
  scheduledTasks    ScheduledTask[]
  metrics           ServerMetrics[]
  consoleLogs       ConsoleLog[]
  tags              ServerTag[]
  favorites         ServerFavorite[]
  groups            ServerGroupMember[]

  @@index([userId])
  @@index([hostId])
  @@index([status])
  @@index([hibernating])
}

enum ServerStatus {
  CREATING
  STOPPED
  STARTING
  RUNNING
  STOPPING
  RESTARTING
  ERROR
  UPDATING
}

enum MinecraftVersionType {
  VANILLA
  SNAPSHOT
  FORGE
  FABRIC
  PAPER
  SPIGOT
  BUKKIT
}

enum Difficulty {
  PEACEFUL
  EASY
  NORMAL
  HARD
}

enum GameMode {
  SURVIVAL
  CREATIVE
  ADVENTURE
  SPECTATOR
}

// ==================== Mod Models ====================
model Mod {
  id                String          @id @default(uuid())
  name              String
  description       String
  version           String
  minecraftVersion  String
  modLoader         ModLoader
  fileUrl           String?
  fileName          String
  fileSize          Int
  author            String
  dependencies      String[]        @default([])
  createdAt         DateTime        @default(now())

  servers           ServerMod[]

  @@index([modLoader])
  @@index([minecraftVersion])
}

enum ModLoader {
  FORGE
  FABRIC
  QUILT
}

model ServerMod {
  id          String          @id @default(uuid())
  modId       String
  serverId    String
  enabled     Boolean         @default(true)
  installedAt DateTime        @default(now())

  mod         Mod             @relation(fields: [modId], references: [id], onDelete: Cascade)
  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([modId, serverId])
  @@index([serverId])
}

// ==================== Backup Models ====================
model Backup {
  id          String          @id @default(uuid())
  serverId    String
  name        String
  size        Int             // in bytes
  type        BackupType
  status      BackupStatus    @default(CREATING)
  filePath    String
  createdAt   DateTime        @default(now())
  restoredAt  DateTime?

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([status])
  @@index([createdAt])
  @@index([type, createdAt])
}

enum BackupType {
  MANUAL
  AUTOMATIC
  PRE_UPDATE
}

enum BackupStatus {
  CREATING
  COMPLETED
  FAILED
  RESTORING
}

// ==================== Stats Models ====================
model ServerStats {
  id            String          @id @default(uuid())
  serverId      String          @unique
  onlinePlayers Int             @default(0)
  maxPlayers    Int             @default(20)
  tps           Float           @default(20.0)
  ramUsage      Int             @default(0)
  cpuUsage      Float           @default(0)
  uptime        Int             @default(0)
  lastUpdated   DateTime        @default(now())

  server        MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ==================== Minecraft Version Models ====================
model MinecraftVersion {
  id            String                @id @default(uuid())
  version       String                @unique
  type          MinecraftVersionType
  releaseDate   DateTime
  downloadUrl   String?
  isStable      Boolean               @default(true)

  @@index([type])
  @@index([version])
}

// ==================== Server Template Models ====================
model ServerTemplate {
  id                String              @id @default(uuid())
  name              String
  description       String
  minecraftVersion  String
  versionType       MinecraftVersionType
  allocatedRam      Int                 // in MB
  allocatedCpu      Float
  maxPlayers        Int                 @default(20)
  difficulty        Difficulty          @default(NORMAL)
  gameMode          GameMode            @default(SURVIVAL)
  enableWhitelist   Boolean             @default(false)
  preInstalledMods  String[]            @default([])
  serverProperties  Json?               // Custom server.properties
  isPublic          Boolean             @default(true)
  createdBy         String?
  downloads         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([isPublic])
  @@index([versionType])
}

// ==================== Player Management Models ====================
model PlayerWhitelist {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  addedAt     DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

model PlayerBan {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  reason      String?
  bannedBy    String?
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

model PlayerOperator {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  level       Int             @default(4)
  addedAt     DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

// ==================== Scheduled Task Models ====================
model ScheduledTask {
  id            String          @id @default(uuid())
  serverId      String
  name          String
  taskType      TaskType
  cronExpression String
  command       String?
  enabled       Boolean         @default(true)
  lastRun       DateTime?
  nextRun       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  server        MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([enabled])
  @@index([nextRun])
}

enum TaskType {
  BACKUP
  RESTART
  COMMAND
  ANNOUNCEMENT
}

// ==================== Notification Models ====================
model NotificationConfig {
  id          String              @id @default(uuid())
  userId      String
  serverId    String?
  type        NotificationType
  enabled     Boolean             @default(true)
  email       String?
  webhookUrl  String?
  events      NotificationEvent[] @default([])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([serverId])
}

enum NotificationType {
  EMAIL
  WEBHOOK
  DISCORD
}

enum NotificationEvent {
  SERVER_STARTED
  SERVER_STOPPED
  SERVER_CRASHED
  BACKUP_COMPLETED
  BACKUP_FAILED
  PLAYER_JOINED
  PLAYER_LEFT
  HIGH_CPU_USAGE
  HIGH_RAM_USAGE
  LOW_TPS
}

// ==================== Advanced Analytics Models ====================
model ServerMetrics {
  id              String          @id @default(uuid())
  serverId        String
  timestamp       DateTime        @default(now())
  cpuUsage        Float
  ramUsage        Int
  diskUsage       Int?
  tps             Float
  onlinePlayers   Int
  chunks          Int?
  entities        Int?
  tileEntities    Int?

  server          MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp])
  @@index([timestamp])
}

model ConsoleLog {
  id          String          @id @default(uuid())
  serverId    String
  message     String
  level       LogLevel        @default(INFO)
  timestamp   DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp])
  @@index([timestamp])
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  SEVERE
  DEBUG
}

// ==================== Server Organization Models ====================
model ServerTag {
  id          String          @id @default(uuid())
  serverId    String
  name        String
  color       String?
  createdAt   DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
  @@index([serverId])
}

model ServerFavorite {
  id          String          @id @default(uuid())
  userId      String
  serverId    String
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId])
}

model ServerGroup {
  id          String              @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String?
  icon        String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  servers     ServerGroupMember[]

  @@index([userId])
}

model ServerGroupMember {
  id          String          @id @default(uuid())
  groupId     String
  serverId    String
  addedAt     DateTime        @default(now())

  group       ServerGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([groupId, serverId])
  @@index([groupId])
  @@index([serverId])
}

// ==================== Team/Organization Models ====================
model Organization {
  id          String                @id @default(uuid())
  name        String
  description String?
  ownerId     String
  plan        OrganizationPlan      @default(FREE)
  maxMembers  Int                   @default(5)
  maxServers  Int                   @default(10)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  members     OrganizationMember[]
  invitations OrganizationInvitation[]

  @@index([ownerId])
}

enum OrganizationPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model OrganizationMember {
  id              String        @id @default(uuid())
  organizationId  String
  userId          String
  role            OrgRole       @default(MEMBER)
  joinedAt        DateTime      @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model OrganizationInvitation {
  id              String        @id @default(uuid())
  organizationId  String
  email           String
  role            OrgRole       @default(MEMBER)
  token           String        @unique
  expiresAt       DateTime
  createdAt       DateTime      @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([organizationId])
}

// ==================== Audit Log Models ====================
model AuditLog {
  id          String      @id @default(uuid())
  userId      String
  action      String
  resourceType String
  resourceId   String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@index([action])
}

// ==================== Bulk Operations Models ====================
model BulkOperation {
  id              String              @id @default(uuid())
  userId          String
  operationType   BulkOperationType
  status          BulkOperationStatus @default(PENDING)
  totalTargets    Int
  completed       Int                 @default(0)
  failed          Int                 @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())

  results         BulkOperationResult[]

  @@index([userId])
  @@index([status])
}

enum BulkOperationType {
  START_SERVERS
  STOP_SERVERS
  RESTART_SERVERS
  UPDATE_RESOURCES
  BACKUP_SERVERS
  UPDATE_CONFIG
  INSTALL_PLUGIN
  EXECUTE_COMMAND
}

enum BulkOperationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model BulkOperationResult {
  id              String          @id @default(uuid())
  operationId     String
  serverId        String
  status          String
  message         String?
  timestamp       DateTime        @default(now())

  operation       BulkOperation   @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@index([serverId])
}

// ==================== Plugin Marketplace Models ====================
model MarketplacePlugin {
  id              String              @id @default(uuid())
  name            String
  description     String
  longDescription String?
  author          String
  authorId        String?
  version         String
  minecraftVersions String[]
  category        PluginCategory
  tags            String[]            @default([])
  downloads       Int                 @default(0)
  rating          Float               @default(0)
  reviewCount     Int                 @default(0)
  price           Float               @default(0) // 0 = free
  fileUrl         String?
  fileName        String
  fileSize        Int
  thumbnailUrl    String?
  screenshots     String[]            @default([])
  dependencies    String[]            @default([])
  isPublic        Boolean             @default(true)
  isFeatured      Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  reviews         PluginReview[]
  installations   PluginInstallation[]

  @@index([category])
  @@index([isPublic, isFeatured])
  @@index([downloads])
  @@index([rating])
}

enum PluginCategory {
  GAMEPLAY
  MECHANICS
  ECONOMY
  ADMIN_TOOLS
  WORLD_MANAGEMENT
  CHAT
  UTILITIES
  FUN
  PROTECTION
  MINIGAMES
}

model PluginReview {
  id          String            @id @default(uuid())
  pluginId    String
  userId      String
  rating      Int               // 1-5
  comment     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  plugin      MarketplacePlugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, userId])
  @@index([pluginId])
  @@index([rating])
}

model PluginInstallation {
  id          String            @id @default(uuid())
  pluginId    String
  serverId    String
  version     String
  installedAt DateTime          @default(now())

  plugin      MarketplacePlugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, serverId])
  @@index([pluginId])
  @@index([serverId])
}

// ==================== AI & Optimization Models ====================
model OptimizationRecommendation {
  id              String                  @id @default(uuid())
  serverId        String
  type            OptimizationType
  severity        RecommendationSeverity
  title           String
  description     String
  estimatedImpact String
  applied         Boolean                 @default(false)
  appliedAt       DateTime?
  createdAt       DateTime                @default(now())

  @@index([serverId])
  @@index([applied])
  @@index([severity])
}

enum OptimizationType {
  RAM_OPTIMIZATION
  CPU_OPTIMIZATION
  JVM_FLAGS
  PLUGIN_OPTIMIZATION
  WORLD_OPTIMIZATION
  NETWORK_OPTIMIZATION
  DISK_OPTIMIZATION
}

enum RecommendationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ServerHealthCheck {
  id              String      @id @default(uuid())
  serverId        String
  healthy         Boolean
  healthScore     Int         // 0-100
  issues          Json[]
  cpuUsage        Float
  memoryUsage     Float
  diskUsage       Float?
  tps             Float?
  responsive      Boolean
  lastChecked     DateTime    @default(now())

  @@index([serverId])
  @@index([healthy])
  @@index([lastChecked])
}
