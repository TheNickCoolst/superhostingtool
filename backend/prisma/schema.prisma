// Prisma Schema für Minecraft Hosting Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== User Models ====================
model User {
  id            String          @id @default(uuid())
  email         String          @unique
  username      String          @unique
  password      String
  role          UserRole        @default(USER)
  maxServers    Int             @default(9)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  servers       MinecraftServer[]

  @@index([email])
  @@index([username])
}

enum UserRole {
  ADMIN
  USER
  MODERATOR
}

// ==================== Host Models ====================
model Host {
  id              String          @id @default(uuid())
  name            String
  ipAddress       String          @unique
  apiKey          String
  status          HostStatus      @default(OFFLINE)
  totalRam        Int             // in MB
  totalCpu        Float           // number of cores
  usedRam         Int             @default(0)
  usedCpu         Float           @default(0)
  maxServers      Int             @default(50)
  activeServers   Int             @default(0)
  region          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastHeartbeat   DateTime?

  servers         MinecraftServer[]

  @@index([status])
  @@index([region])
}

enum HostStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  OVERLOADED
}

// ==================== Minecraft Server Models ====================
model MinecraftServer {
  id                String              @id @default(uuid())
  name              String
  userId            String
  hostId            String
  status            ServerStatus        @default(CREATING)
  version           String
  minecraftVersion  MinecraftVersionType
  port              Int
  allocatedRam      Int                 // in MB
  allocatedCpu      Float               // in cores
  maxPlayers        Int                 @default(20)
  difficulty        Difficulty          @default(NORMAL)
  gameMode          GameMode            @default(SURVIVAL)
  enableWhitelist   Boolean             @default(false)
  containerName     String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lastStarted       DateTime?

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  host              Host                @relation(fields: [hostId], references: [id])
  mods              ServerMod[]
  backups           Backup[]
  stats             ServerStats?
  whitelist         PlayerWhitelist[]
  bans              PlayerBan[]
  operators         PlayerOperator[]
  scheduledTasks    ScheduledTask[]
  metrics           ServerMetrics[]
  consoleLogs       ConsoleLog[]

  @@index([userId])
  @@index([hostId])
  @@index([status])
  @@index([userId, status])
  @@index([hostId, status])
  @@index([createdAt])
  @@index([lastStarted])
}

enum ServerStatus {
  CREATING
  STOPPED
  STARTING
  RUNNING
  STOPPING
  RESTARTING
  ERROR
  UPDATING
}

enum MinecraftVersionType {
  VANILLA
  SNAPSHOT
  FORGE
  FABRIC
  PAPER
  SPIGOT
  BUKKIT
}

enum Difficulty {
  PEACEFUL
  EASY
  NORMAL
  HARD
}

enum GameMode {
  SURVIVAL
  CREATIVE
  ADVENTURE
  SPECTATOR
}

// ==================== Mod Models ====================
model Mod {
  id                String          @id @default(uuid())
  name              String
  description       String
  version           String
  minecraftVersion  String
  modLoader         ModLoader
  fileUrl           String?
  fileName          String
  fileSize          Int
  author            String
  dependencies      String[]        @default([])
  createdAt         DateTime        @default(now())

  servers           ServerMod[]

  @@index([modLoader])
  @@index([minecraftVersion])
}

enum ModLoader {
  FORGE
  FABRIC
  QUILT
}

model ServerMod {
  id          String          @id @default(uuid())
  modId       String
  serverId    String
  enabled     Boolean         @default(true)
  installedAt DateTime        @default(now())

  mod         Mod             @relation(fields: [modId], references: [id], onDelete: Cascade)
  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([modId, serverId])
  @@index([serverId])
}

// ==================== Backup Models ====================
model Backup {
  id          String          @id @default(uuid())
  serverId    String
  name        String
  size        Int             // in bytes
  type        BackupType
  status      BackupStatus    @default(CREATING)
  filePath    String
  createdAt   DateTime        @default(now())
  restoredAt  DateTime?

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([status])
  @@index([serverId, createdAt])
  @@index([serverId, status])
  @@index([createdAt])
}

enum BackupType {
  MANUAL
  AUTOMATIC
  PRE_UPDATE
}

enum BackupStatus {
  CREATING
  COMPLETED
  FAILED
  RESTORING
}

// ==================== Stats Models ====================
model ServerStats {
  id            String          @id @default(uuid())
  serverId      String          @unique
  onlinePlayers Int             @default(0)
  maxPlayers    Int             @default(20)
  tps           Float           @default(20.0)
  ramUsage      Int             @default(0)
  cpuUsage      Float           @default(0)
  uptime        Int             @default(0)
  lastUpdated   DateTime        @default(now())

  server        MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ==================== Minecraft Version Models ====================
model MinecraftVersion {
  id            String                @id @default(uuid())
  version       String                @unique
  type          MinecraftVersionType
  releaseDate   DateTime
  downloadUrl   String?
  isStable      Boolean               @default(true)

  @@index([type])
  @@index([version])
}

// ==================== Server Template Models ====================
model ServerTemplate {
  id                String              @id @default(uuid())
  name              String
  description       String
  minecraftVersion  String
  versionType       MinecraftVersionType
  allocatedRam      Int                 // in MB
  allocatedCpu      Float
  maxPlayers        Int                 @default(20)
  difficulty        Difficulty          @default(NORMAL)
  gameMode          GameMode            @default(SURVIVAL)
  enableWhitelist   Boolean             @default(false)
  preInstalledMods  String[]            @default([])
  serverProperties  Json?               // Custom server.properties
  isPublic          Boolean             @default(true)
  createdBy         String?
  downloads         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([isPublic])
  @@index([versionType])
}

// ==================== Player Management Models ====================
model PlayerWhitelist {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  addedAt     DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

model PlayerBan {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  reason      String?
  bannedBy    String?
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

model PlayerOperator {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  level       Int             @default(4)
  addedAt     DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

// ==================== Scheduled Task Models ====================
model ScheduledTask {
  id            String          @id @default(uuid())
  serverId      String
  name          String
  taskType      TaskType
  cronExpression String
  command       String?
  enabled       Boolean         @default(true)
  lastRun       DateTime?
  nextRun       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  server        MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([enabled])
  @@index([nextRun])
  @@index([serverId, enabled])
  @@index([enabled, nextRun])
}

enum TaskType {
  BACKUP
  RESTART
  COMMAND
  ANNOUNCEMENT
}

// ==================== Notification Models ====================
model NotificationConfig {
  id          String              @id @default(uuid())
  userId      String
  serverId    String?
  type        NotificationType
  enabled     Boolean             @default(true)
  email       String?
  webhookUrl  String?
  events      NotificationEvent[] @default([])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([serverId])
  @@index([userId, enabled])
  @@index([serverId, type])
}

enum NotificationType {
  EMAIL
  WEBHOOK
  DISCORD
}

enum NotificationEvent {
  SERVER_STARTED
  SERVER_STOPPED
  SERVER_CRASHED
  BACKUP_COMPLETED
  BACKUP_FAILED
  PLAYER_JOINED
  PLAYER_LEFT
  HIGH_CPU_USAGE
  HIGH_RAM_USAGE
  LOW_TPS
}

// ==================== Advanced Analytics Models ====================
model ServerMetrics {
  id              String          @id @default(uuid())
  serverId        String
  timestamp       DateTime        @default(now())
  cpuUsage        Float
  ramUsage        Int
  diskUsage       Int?
  tps             Float
  onlinePlayers   Int
  chunks          Int?
  entities        Int?
  tileEntities    Int?

  server          MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@index([serverId])
}

model ConsoleLog {
  id          String          @id @default(uuid())
  serverId    String
  message     String
  level       LogLevel        @default(INFO)
  timestamp   DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp])
  @@index([timestamp])
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  SEVERE
  DEBUG
}
