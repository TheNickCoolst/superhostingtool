// Prisma Schema für Minecraft Hosting Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== User Models ====================
model User {
  id            String          @id @default(uuid())
  email         String          @unique
  username      String          @unique
  password      String
  role          UserRole        @default(USER)
  maxServers    Int             @default(9)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  servers       MinecraftServer[]

  @@index([email])
  @@index([username])
}

enum UserRole {
  ADMIN
  USER
  MODERATOR
}

// ==================== Host Models ====================
model Host {
  id              String          @id @default(uuid())
  name            String
  ipAddress       String          @unique
  apiKey          String
  status          HostStatus      @default(OFFLINE)
  totalRam        Int             // in MB
  totalCpu        Float           // number of cores
  usedRam         Int             @default(0)
  usedCpu         Float           @default(0)
  maxServers      Int             @default(50)
  activeServers   Int             @default(0)
  region          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastHeartbeat   DateTime?

  servers         MinecraftServer[]

  @@index([status])
  @@index([region])
  @@index([lastHeartbeat])
}

enum HostStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  OVERLOADED
}

// ==================== Minecraft Server Models ====================
model MinecraftServer {
  id                String              @id @default(uuid())
  name              String
  userId            String
  hostId            String
  status            ServerStatus        @default(CREATING)
  version           String
  minecraftVersion  MinecraftVersionType
  port              Int
  allocatedRam      Int                 // in MB
  allocatedCpu      Float               // in cores
  maxPlayers        Int                 @default(20)
  difficulty        Difficulty          @default(NORMAL)
  gameMode          GameMode            @default(SURVIVAL)
  enableWhitelist   Boolean             @default(false)
  containerName     String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lastStarted       DateTime?

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  host              Host                @relation(fields: [hostId], references: [id])
  mods              ServerMod[]
  backups           Backup[]
  stats             ServerStats?
  whitelist         PlayerWhitelist[]
  bans              PlayerBan[]
  operators         PlayerOperator[]
  scheduledTasks    ScheduledTask[]
  metrics           ServerMetrics[]
  consoleLogs       ConsoleLog[]

  @@index([userId])
  @@index([hostId])
  @@index([status])
}

enum ServerStatus {
  CREATING
  STOPPED
  STARTING
  RUNNING
  STOPPING
  RESTARTING
  ERROR
  UPDATING
}

enum MinecraftVersionType {
  VANILLA
  SNAPSHOT
  FORGE
  FABRIC
  PAPER
  SPIGOT
  BUKKIT
}

enum Difficulty {
  PEACEFUL
  EASY
  NORMAL
  HARD
}

enum GameMode {
  SURVIVAL
  CREATIVE
  ADVENTURE
  SPECTATOR
}

// ==================== Mod Models ====================
model Mod {
  id                String          @id @default(uuid())
  name              String
  description       String
  version           String
  minecraftVersion  String
  modLoader         ModLoader
  fileUrl           String?
  fileName          String
  fileSize          Int
  author            String
  dependencies      String[]        @default([])
  createdAt         DateTime        @default(now())

  servers           ServerMod[]

  @@index([modLoader])
  @@index([minecraftVersion])
}

enum ModLoader {
  FORGE
  FABRIC
  QUILT
}

model ServerMod {
  id          String          @id @default(uuid())
  modId       String
  serverId    String
  enabled     Boolean         @default(true)
  installedAt DateTime        @default(now())

  mod         Mod             @relation(fields: [modId], references: [id], onDelete: Cascade)
  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([modId, serverId])
  @@index([serverId])
}

// ==================== Backup Models ====================
model Backup {
  id          String          @id @default(uuid())
  serverId    String
  name        String
  size        Int             // in bytes
  type        BackupType
  status      BackupStatus    @default(CREATING)
  filePath    String
  createdAt   DateTime        @default(now())
  restoredAt  DateTime?

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([status])
  @@index([createdAt])
  @@index([type, createdAt])
}

enum BackupType {
  MANUAL
  AUTOMATIC
  PRE_UPDATE
}

enum BackupStatus {
  CREATING
  COMPLETED
  FAILED
  RESTORING
}

// ==================== Stats Models ====================
model ServerStats {
  id            String          @id @default(uuid())
  serverId      String          @unique
  onlinePlayers Int             @default(0)
  maxPlayers    Int             @default(20)
  tps           Float           @default(20.0)
  ramUsage      Int             @default(0)
  cpuUsage      Float           @default(0)
  uptime        Int             @default(0)
  lastUpdated   DateTime        @default(now())

  server        MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ==================== Minecraft Version Models ====================
model MinecraftVersion {
  id            String                @id @default(uuid())
  version       String                @unique
  type          MinecraftVersionType
  releaseDate   DateTime
  downloadUrl   String?
  isStable      Boolean               @default(true)

  @@index([type])
  @@index([version])
}

// ==================== Server Template Models ====================
model ServerTemplate {
  id                String              @id @default(uuid())
  name              String
  description       String
  minecraftVersion  String
  versionType       MinecraftVersionType
  allocatedRam      Int                 // in MB
  allocatedCpu      Float
  maxPlayers        Int                 @default(20)
  difficulty        Difficulty          @default(NORMAL)
  gameMode          GameMode            @default(SURVIVAL)
  enableWhitelist   Boolean             @default(false)
  preInstalledMods  String[]            @default([])
  serverProperties  Json?               // Custom server.properties
  isPublic          Boolean             @default(true)
  createdBy         String?
  downloads         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([isPublic])
  @@index([versionType])
}

// ==================== Player Management Models ====================
model PlayerWhitelist {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  addedAt     DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

model PlayerBan {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  reason      String?
  bannedBy    String?
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

model PlayerOperator {
  id          String          @id @default(uuid())
  serverId    String
  playerName  String
  playerUuid  String?
  level       Int             @default(4)
  addedAt     DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, playerName])
  @@index([serverId])
}

// ==================== Scheduled Task Models ====================
model ScheduledTask {
  id            String          @id @default(uuid())
  serverId      String
  name          String
  taskType      TaskType
  cronExpression String
  command       String?
  enabled       Boolean         @default(true)
  lastRun       DateTime?
  nextRun       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  server        MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([enabled])
  @@index([nextRun])
}

enum TaskType {
  BACKUP
  RESTART
  COMMAND
  ANNOUNCEMENT
}

// ==================== Notification Models ====================
model NotificationConfig {
  id          String              @id @default(uuid())
  userId      String
  serverId    String?
  type        NotificationType
  enabled     Boolean             @default(true)
  email       String?
  webhookUrl  String?
  events      NotificationEvent[] @default([])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([serverId])
}

enum NotificationType {
  EMAIL
  WEBHOOK
  DISCORD
}

enum NotificationEvent {
  SERVER_STARTED
  SERVER_STOPPED
  SERVER_CRASHED
  BACKUP_COMPLETED
  BACKUP_FAILED
  PLAYER_JOINED
  PLAYER_LEFT
  HIGH_CPU_USAGE
  HIGH_RAM_USAGE
  LOW_TPS
}

// ==================== Advanced Analytics Models ====================
model ServerMetrics {
  id              String          @id @default(uuid())
  serverId        String
  timestamp       DateTime        @default(now())
  cpuUsage        Float
  ramUsage        Int
  diskUsage       Int?
  tps             Float
  onlinePlayers   Int
  chunks          Int?
  entities        Int?
  tileEntities    Int?

  server          MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp])
  @@index([timestamp])
}

model ConsoleLog {
  id          String          @id @default(uuid())
  serverId    String
  message     String
  level       LogLevel        @default(INFO)
  timestamp   DateTime        @default(now())

  server      MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp])
  @@index([timestamp])
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  SEVERE
  DEBUG
}

// ==================== Multi-Tenancy Models ====================
model Organization {
  id              String              @id @default(uuid())
  name            String
  slug            String              @unique
  description     String?
  plan            SubscriptionPlan    @default(FREE)
  maxServers      Int                 @default(5)
  maxMembers      Int                 @default(10)
  customDomain    String?
  logoUrl         String?
  settings        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  members         OrganizationMember[]
  teams           Team[]
  servers         OrganizationServer[]
  quotas          ResourceQuota[]
  apiKeys         ApiKey[]
  webhooks        Webhook[]
  auditLogs       AuditLog[]
  invoices        Invoice[]

  @@index([slug])
  @@index([plan])
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

model OrganizationMember {
  id              String          @id @default(uuid())
  organizationId  String
  userId          String
  role            OrganizationRole @default(MEMBER)
  permissions     String[]        @default([])
  invitedBy       String?
  joinedAt        DateTime        @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  BILLING_MANAGER
}

model Team {
  id              String          @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  color           String?
  permissions     String[]        @default([])
  createdAt       DateTime        @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  servers         TeamServer[]

  @@index([organizationId])
}

model TeamMember {
  id          String      @id @default(uuid())
  teamId      String
  userId      String
  addedAt     DateTime    @default(now())

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model OrganizationServer {
  id              String          @id @default(uuid())
  organizationId  String
  serverId        String          @unique

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model TeamServer {
  id          String      @id @default(uuid())
  teamId      String
  serverId    String
  permissions String[]    @default([])
  addedAt     DateTime    @default(now())

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, serverId])
}

// ==================== Resource Quota Models ====================
model ResourceQuota {
  id              String          @id @default(uuid())
  organizationId  String
  resourceType    ResourceType
  limit           Int
  used            Int             @default(0)
  resetPeriod     ResetPeriod     @default(MONTHLY)
  lastReset       DateTime        @default(now())
  alertThreshold  Int?            // percentage

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, resourceType])
  @@index([organizationId])
}

enum ResourceType {
  SERVERS
  RAM_GB
  STORAGE_GB
  BANDWIDTH_GB
  BACKUPS
  API_REQUESTS
}

enum ResetPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  NEVER
}

// ==================== API & Webhook Models ====================
model ApiKey {
  id              String          @id @default(uuid())
  organizationId  String
  name            String
  key             String          @unique
  permissions     String[]        @default([])
  rateLimit       Int             @default(1000)
  expiresAt       DateTime?
  lastUsed        DateTime?
  createdAt       DateTime        @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([key])
}

model Webhook {
  id              String          @id @default(uuid())
  organizationId  String
  name            String
  url             String
  secret          String
  events          String[]        @default([])
  enabled         Boolean         @default(true)
  retryAttempts   Int             @default(3)
  lastTriggered   DateTime?
  failureCount    Int             @default(0)
  createdAt       DateTime        @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id              String              @id @default(uuid())
  webhookId       String
  event           String
  payload         Json
  status          WebhookStatus       @default(PENDING)
  statusCode      Int?
  response        String?
  attempts        Int                 @default(0)
  nextRetry       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime            @default(now())

  webhook         Webhook             @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([createdAt])
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

// ==================== Audit & Compliance Models ====================
model AuditLog {
  id              String          @id @default(uuid())
  organizationId  String
  userId          String?
  action          String
  resource        String
  resourceId      String?
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  severity        AuditSeverity   @default(INFO)
  timestamp       DateTime        @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, timestamp])
  @@index([userId])
  @@index([action])
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

// ==================== Security Models ====================
model TwoFactorAuth {
  id              String          @id @default(uuid())
  userId          String          @unique
  secret          String
  backupCodes     String[]
  enabled         Boolean         @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([userId])
}

model Session {
  id              String          @id @default(uuid())
  userId          String
  token           String          @unique
  ipAddress       String?
  userAgent       String?
  expiresAt       DateTime
  lastActivity    DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model SecurityEvent {
  id              String              @id @default(uuid())
  userId          String?
  eventType       SecurityEventType
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  blocked         Boolean             @default(false)
  timestamp       DateTime            @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([timestamp])
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  EMAIL_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  API_KEY_CREATED
  API_KEY_DELETED
  SUSPICIOUS_ACTIVITY
  RATE_LIMIT_EXCEEDED
}

// ==================== Billing Models ====================
model Invoice {
  id              String          @id @default(uuid())
  organizationId  String
  invoiceNumber   String          @unique
  amount          Float
  currency        String          @default("USD")
  status          InvoiceStatus   @default(PENDING)
  dueDate         DateTime
  paidAt          DateTime?
  items           Json
  metadata        Json?
  createdAt       DateTime        @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([organizationId])
  @@index([status])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Payment {
  id              String          @id @default(uuid())
  invoiceId       String
  amount          Float
  currency        String          @default("USD")
  method          PaymentMethod
  transactionId   String?
  status          PaymentStatus   @default(PENDING)
  metadata        Json?
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  invoice         Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAL
  STRIPE
  BANK_TRANSFER
  CRYPTO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ==================== Plugin & Marketplace Models ====================
model Plugin {
  id                  String              @id @default(uuid())
  name                String
  slug                String              @unique
  description         String
  longDescription     String?
  version             String
  author              String
  authorId            String?
  category            PluginCategory
  iconUrl             String?
  screenshots         String[]            @default([])
  downloadUrl         String
  sourceUrl           String?
  documentationUrl    String?
  minecraftVersions   String[]            @default([])
  dependencies        String[]            @default([])
  price               Float               @default(0)
  currency            String              @default("USD")
  downloads           Int                 @default(0)
  rating              Float               @default(0)
  reviewCount         Int                 @default(0)
  featured            Boolean             @default(false)
  verified            Boolean             @default(false)
  status              PluginStatus        @default(PENDING)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  installations       PluginInstallation[]
  reviews             PluginReview[]

  @@index([slug])
  @@index([category])
  @@index([featured])
  @@index([status])
}

enum PluginCategory {
  ADMINISTRATION
  GAMEPLAY
  MECHANICS
  ECONOMY
  CHAT
  TELEPORTATION
  WORLD_MANAGEMENT
  PROTECTION
  FUN
  DEVELOPER_TOOLS
  MISC
}

enum PluginStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

model PluginInstallation {
  id              String          @id @default(uuid())
  pluginId        String
  serverId        String
  version         String
  enabled         Boolean         @default(true)
  config          Json?
  installedAt     DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  plugin          Plugin          @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, serverId])
  @@index([serverId])
}

model PluginReview {
  id          String      @id @default(uuid())
  pluginId    String
  userId      String
  rating      Int
  comment     String?
  helpful     Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  plugin      Plugin      @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, userId])
  @@index([pluginId])
}

// ==================== Network & Proxy Models ====================
model ProxyServer {
  id              String          @id @default(uuid())
  name            String
  type            ProxyType
  hostId          String
  port            Int
  status          ServerStatus    @default(STOPPED)
  maxPlayers      Int             @default(500)
  allocatedRam    Int
  containerName   String          @unique
  config          Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  linkedServers   ProxyServerLink[]

  @@index([type])
  @@index([status])
}

enum ProxyType {
  BUNGEECORD
  VELOCITY
  WATERFALL
}

model ProxyServerLink {
  id          String          @id @default(uuid())
  proxyId     String
  serverId    String
  priority    Int             @default(0)
  restricted  Boolean         @default(false)
  createdAt   DateTime        @default(now())

  proxy       ProxyServer     @relation(fields: [proxyId], references: [id], onDelete: Cascade)

  @@unique([proxyId, serverId])
  @@index([proxyId])
}

model DomainMapping {
  id              String          @id @default(uuid())
  domain          String          @unique
  serverId        String?
  proxyId         String?
  sslEnabled      Boolean         @default(false)
  sslCertPath     String?
  verified        Boolean         @default(false)
  verificationKey String?
  createdAt       DateTime        @default(now())

  @@index([domain])
}

// ==================== AI & Analytics Models ====================
model AIRecommendation {
  id              String              @id @default(uuid())
  serverId        String
  type            RecommendationType
  title           String
  description     String
  impact          ImpactLevel
  confidence      Float
  metadata        Json?
  applied         Boolean             @default(false)
  appliedAt       DateTime?
  dismissed       Boolean             @default(false)
  createdAt       DateTime            @default(now())

  @@index([serverId])
  @@index([type])
  @@index([applied])
}

enum RecommendationType {
  RESOURCE_OPTIMIZATION
  PERFORMANCE_TUNING
  SECURITY_IMPROVEMENT
  COST_REDUCTION
  PLAYER_RETENTION
  BACKUP_STRATEGY
}

enum ImpactLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model PerformanceAlert {
  id              String          @id @default(uuid())
  serverId        String
  alertType       AlertType
  severity        AlertSeverity
  message         String
  metadata        Json?
  resolved        Boolean         @default(false)
  resolvedAt      DateTime?
  acknowledgedBy  String?
  createdAt       DateTime        @default(now())

  @@index([serverId])
  @@index([resolved])
  @@index([severity])
}

enum AlertType {
  HIGH_CPU
  HIGH_RAM
  LOW_TPS
  HIGH_LATENCY
  DISK_SPACE
  CRASH_DETECTED
  UNUSUAL_PLAYER_DROP
  PLUGIN_ERROR
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model PlayerAnalytics {
  id              String          @id @default(uuid())
  serverId        String
  date            DateTime        @default(now())
  uniquePlayers   Int
  peakPlayers     Int
  averagePlayers  Float
  totalPlaytime   Int             // in minutes
  newPlayers      Int
  returningPlayers Int
  churnRate       Float?
  metadata        Json?

  @@unique([serverId, date])
  @@index([serverId])
  @@index([date])
}

// ==================== Advanced Backup Models ====================
model BackupPolicy {
  id              String          @id @default(uuid())
  serverId        String
  name            String
  enabled         Boolean         @default(true)
  schedule        String          // cron expression
  retentionDays   Int             @default(7)
  maxBackups      Int             @default(10)
  includeWorlds   Boolean         @default(true)
  includePlugins  Boolean         @default(true)
  includeConfig   Boolean         @default(true)
  compression     CompressionType @default(GZIP)
  encryption      Boolean         @default(false)
  storageLocation StorageLocation @default(LOCAL)
  s3Bucket        String?
  s3Region        String?
  createdAt       DateTime        @default(now())

  @@index([serverId])
}

enum CompressionType {
  NONE
  GZIP
  ZSTD
  BZIP2
}

enum StorageLocation {
  LOCAL
  S3
  GOOGLE_CLOUD
  AZURE
  FTP
}

model Snapshot {
  id              String          @id @default(uuid())
  serverId        String
  name            String
  description     String?
  size            Int
  worldData       Boolean         @default(true)
  plugins         Boolean         @default(true)
  config          Boolean         @default(true)
  filePath        String
  metadata        Json?
  createdAt       DateTime        @default(now())

  @@index([serverId])
}

// ==================== World Management Models ====================
model WorldTemplate {
  id              String          @id @default(uuid())
  name            String
  description     String
  category        WorldCategory
  minecraftVersion String
  seed            String?
  thumbnail       String?
  downloadUrl     String
  fileSize        Int
  downloads       Int             @default(0)
  rating          Float           @default(0)
  featured        Boolean         @default(false)
  createdBy       String?
  createdAt       DateTime        @default(now())

  @@index([category])
  @@index([featured])
}

enum WorldCategory {
  SURVIVAL
  CREATIVE
  ADVENTURE
  PARKOUR
  MINIGAMES
  SKYBLOCK
  PRISON
  FACTIONS
  CUSTOM
}

model ServerWorld {
  id              String          @id @default(uuid())
  serverId        String
  name            String
  dimension       WorldDimension
  seed            String?
  size            Int             // in MB
  active          Boolean         @default(true)
  generatorSettings Json?
  lastModified    DateTime        @default(now())

  @@unique([serverId, name, dimension])
  @@index([serverId])
}

enum WorldDimension {
  OVERWORLD
  NETHER
  END
  CUSTOM
}

// ==================== Monitoring Integration Models ====================
model PrometheusConfig {
  id              String          @id @default(uuid())
  serverId        String          @unique
  enabled         Boolean         @default(false)
  endpoint        String
  scrapeInterval  Int             @default(15)
  labels          Json?
  createdAt       DateTime        @default(now())

  @@index([enabled])
}

model GrafanaDashboard {
  id              String          @id @default(uuid())
  name            String
  serverId        String?
  organizationId  String?
  dashboardJson   Json
  isPublic        Boolean         @default(false)
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([serverId])
  @@index([organizationId])
}

// ==================== Cache Models ====================
model CacheEntry {
  id              String          @id @default(uuid())
  key             String          @unique
  value           String
  tags            String[]        @default([])
  expiresAt       DateTime?
  hitCount        Int             @default(0)
  lastAccessed    DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([key])
  @@index([expiresAt])
  @@index([tags])
}
