# ==================== REQUIRED CONFIGURATION ====================

# Agent API Key for authentication with backend
# CRITICAL: Generate a secure random string (min 32 characters)
# Generate with: openssl rand -base64 32
# This MUST match the API key configured for this host in the backend database
AGENT_API_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# ==================== SERVER CONFIGURATION ====================

# Agent Port
AGENT_PORT=4000

# Node Environment
NODE_ENV=production

# ==================== BACKEND CONNECTION ====================

# Backend Server URL
# Update this to point to your central backend server
BACKEND_URL=http://backend-server:3000

# Host ID from Database
# This is the UUID of the host record in the backend database
# Set this after registering the host in the backend
HOST_ID=host-uuid-from-database

# ==================== STORAGE CONFIGURATION ====================

# Server Base Directory (where Minecraft servers are stored)
# Ensure this directory has sufficient disk space
# Recommended: Dedicated SSD with at least 100GB free space
SERVER_BASE_DIR=/opt/minecraft-servers
